[Unit]
Description=PI WEB server
After=pi-web-sessiond.service
Wants=pi-web-sessiond.service
[Service]
Type=simple
ExecStart=/usr/bin/env "/usr/bin/zsh" -lc "exec node '/home/binbenban/.npm-global/lib/node_modules/@jmfederico/pi-web/dist/server/index.js'"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
